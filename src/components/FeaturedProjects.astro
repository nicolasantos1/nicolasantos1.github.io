---
import type { FeaturedProject } from "../data/projects";
interface Props {
  projects: readonly FeaturedProject[];
}
const { projects } = Astro.props;
---

<div class="grid min-w-0 gap-10 sm:gap-14">
  {projects.map((project, index) => (
    <article
      id={project.nome}
      aria-labelledby={`${project.nome}-title`}
      class="surface project-showcase min-w-0"
    >
      <div class="flex flex-col justify-between gap-6 p-6 sm:p-8 lg:flex-row lg:items-end lg:p-10">
        <div class="max-w-2xl">
          <p class="text-sm text-slate-400">{project.category}</p>
          <h2
            id={`${project.nome}-title`}
            class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-4xl"
          >
            {project.title}
          </h2>
          <p class="mt-4 max-w-xl text-sm leading-7 text-slate-400 sm:text-base">
            {project.description}
          </p>
          <p class="mt-4 max-w-xl text-sm leading-7 text-slate-300">
            <strong class="font-medium text-white">Foco técnico: </strong>
            {project.technicalFocus}
          </p>
          <ul
            class="mt-5 flex flex-wrap gap-2"
            aria-label={`Tecnologias de ${project.title}`}
          >
            {project.tags.map((tag) => (
              <li class="rounded-full border border-white/8 bg-white/5 px-3 py-1.5 text-xs text-slate-300">
                {tag}
              </li>
            ))}
          </ul>
        </div>

        <div class="flex flex-wrap gap-3 lg:shrink-0">
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Abrir site ${project.title} (nova aba)`}
            class="inline-flex items-center justify-center gap-3 rounded-full bg-teal-300 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-teal-200"
          >
            Abrir site <span aria-hidden="true">↗</span>
          </a>
          <a
            href={project.repository}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Ver código de ${project.title} no GitHub (nova aba)`}
            class="inline-flex items-center justify-center gap-3 rounded-full border border-white/15 px-5 py-3 text-sm font-medium text-slate-200 transition hover:-translate-y-0.5 hover:border-teal-300/40 hover:text-teal-200"
          >
            Ver código <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="project-devices">
        <figure class="project-desktop">
          <div class="project-laptop">
            <div class="project-browser" aria-hidden="true">
              <span class="project-browser-dots">
                <i />
                <i />
                <i />
              </span>
              <span>{new URL(project.liveUrl).hostname}</span>
              <span class="project-browser-mark">↗</span>
            </div>
            <img
              src={project.desktopImage.src}
              alt={project.desktopImage.alt}
              width={1440}
              height={900}
              sizes="(min-width: 1152px) 760px, (min-width: 768px) 65vw, calc(100vw - 88px)"
              loading={index === 0 ? "eager" : "lazy"}
              class="project-screen"
            />
          </div>
          <div class="project-laptop-base" aria-hidden="true" />
          <figcaption class="project-device-caption">
            Versão desktop ·{" "}
            <a
              href={project.desktopImage.src}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ampliar captura de ${project.title} no desktop (nova aba)`}
              class="inline-flex min-h-11 items-center rounded-sm text-teal-200 underline underline-offset-4 hover:text-teal-100"
            >
              Ampliar captura ↗
            </a>
          </figcaption>
        </figure>

        <figure class="project-mobile">
          <div class="project-phone">
            <div class="project-phone-camera" aria-hidden="true" />
            <img
              src={project.mobileImage.src}
              alt={project.mobileImage.alt}
              width={390}
              height={844}
              sizes="(min-width: 1152px) 220px, (min-width: 768px) 20vw, 260px"
              loading="lazy"
              class="project-screen"
            />
            <div class="project-phone-home" aria-hidden="true" />
          </div>
          <figcaption class="project-device-caption">
            Versão mobile ·{" "}
            <a
              href={project.mobileImage.src}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`Ampliar captura de ${project.title} no celular (nova aba)`}
              class="inline-flex min-h-11 items-center rounded-sm text-teal-200 underline underline-offset-4 hover:text-teal-100"
            >
              Ampliar captura ↗
            </a>
          </figcaption>
        </figure>
      </div>
    </article>
  ))}
</div>
