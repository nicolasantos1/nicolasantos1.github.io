---
interface Props {
  email: string;
}
const { email } = Astro.props;
---

<button
  data-copy-email={email}
  type="button"
  class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-white/15 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:border-teal-300/40 hover:bg-white/5"
>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    class="size-4 shrink-0"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
  >
    <rect x="8" y="8" width="12" height="12" rx="2" />
    <path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
  </svg>
  Copiar e-mail
</button>
<p
  data-copy-status
  role="status"
  aria-live="polite"
  aria-atomic="true"
  class="min-h-6 text-sm leading-6 sm:basis-full text-teal-200"
></p>
<script>
  // One delegated listener also handles pages reached through Astro's router.
  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>("[data-copy-email]");
    if (!button) return;
    const status = button.nextElementSibling;
    if (!(status instanceof HTMLElement)) return;
    const attempt = String(Number(button.dataset.attempt ?? 0) + 1);
    button.dataset.attempt = attempt;
    status.textContent = "";
    status.classList.replace("text-rose-200", "text-teal-200");
    try {
      await navigator.clipboard.writeText(button.dataset.copyEmail!);
      if (!button.isConnected || button.dataset.attempt !== attempt) return;
      status.textContent = "E-mail copiado";
      setTimeout(() => {
        if (button.isConnected && button.dataset.attempt === attempt)
          status.textContent = "";
      }, 3000);
    } catch {
      if (!button.isConnected || button.dataset.attempt !== attempt) return;
      status.textContent =
        "Não foi possível copiar. Selecione o endereço acima.";
      status.classList.replace("text-teal-200", "text-rose-200");
    }
  });
</script>
