---
import { site } from "../data/site";
import Layout from "../layouts/Layout.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import { featuredProjects } from "../data/projects";
---

<Layout
  title={`Projetos | ${site.name}`}
  description={`Projetos de ${site.name}: Debinatos, Frattellianos e IwetI.`}
>
  <section class="mx-auto max-w-6xl px-5 py-8 sm:px-8 lg:py-14">
    <div class="flex flex-col justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="section-kicker">Projetos</p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight text-white sm:text-5xl">
          Projetos que desenvolvi.
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-slate-400 sm:text-lg">
          Participei do desenvolvimento de todos os projetos abaixo. Explore o
          design em diferentes telas e abra cada site para conhecer a
          experiência completa.
        </p>
      </div>
      <a
        href={site.github}
        target="_blank"
        rel="noreferrer"
        class="group inline-flex items-center gap-2 font-medium text-teal-200"
      >
        Ver GitHub
        <span
          aria-hidden="true"
          class="transition-transform group-hover:translate-x-1"
        >
          ↗
        </span>
      </a>
    </div>

    <div class="mt-10 sm:mt-14">
      <FeaturedProjects projects={featuredProjects} />
    </div>
    <div class="mt-12 border-t border-white/10 pt-8">
      <h2 class="text-2xl font-semibold text-white">
        Vamos conversar sobre um projeto?
      </h2>
      <p class="mt-3 text-base leading-7 text-slate-300">
        Entre em contato para trocar ideias ou apresentar uma oportunidade.
      </p>
      <a
        href="/contato"
        class="mt-5 inline-flex min-h-12 items-center rounded-full bg-teal-300 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:bg-teal-200"
      >
        Entrar em contato →
      </a>
    </div>
  </section>
</Layout>
