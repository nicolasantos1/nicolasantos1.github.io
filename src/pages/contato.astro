---
import { site } from "../data/site";
import Layout from "../layouts/Layout.astro";
import CopyEmailButton from "../components/CopyEmailButton.astro";
const email = site.email;
---

<Layout
  title={`Contato | ${site.name}`}
  description={`Entre em contato com ${site.name}.`}
>
  <section
    aria-labelledby="contact-title"
    class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-20 lg:py-28"
  >
    <div class="grid gap-10 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <div class="lg:pt-8">
        <p class="section-kicker">Contato</p>
        <h1
          id="contact-title"
          class="mt-5 max-w-md text-balance text-5xl font-semibold leading-[1.08] tracking-[-0.04em] text-white sm:text-6xl"
        >
          Vamos conversar?
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-8 text-slate-300">
          Quer conversar sobre um projeto, trocar ideias ou apresentar uma
          oportunidade? Entre em contato para conhecermos as possibilidades.
        </p>
      </div>

      <div class="min-w-0">
        <div class="rounded-3xl border border-white/10 bg-[#101c2d] p-6 sm:p-8">
          <div
            aria-hidden="true"
            class="mb-8 flex size-12 items-center justify-center rounded-2xl border border-teal-300/20 bg-teal-300/10 text-teal-200"
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              class="size-6"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="5" width="18" height="14" rx="3" />
              <path d="m3 7 9 6 9-6" />
            </svg>
          </div>
          <h2 class="text-sm font-medium text-teal-200">Contato por e-mail</h2>
          <p class="mt-3 select-text text-base font-semibold tracking-tight text-white [overflow-wrap:anywhere] min-[375px]:text-lg sm:text-2xl lg:text-xl xl:text-2xl">
            {email}
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href={`mailto:${email}`}
              class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-teal-300 px-5 py-3 text-sm font-semibold text-slate-950 transition hover:-translate-y-0.5 hover:bg-teal-200"
            >
              Escrever um e-mail <span aria-hidden="true">↗</span>
            </a>
            <CopyEmailButton email={email} />
          </div>
        </div>

        <div class="mt-6 divide-y divide-white/10 border-y border-white/10">
          <a
            href={site.github}
            target="_blank"
            rel="noreferrer"
            aria-label="GitHub: explore meus repositórios e código (nova aba)"
            class="group flex items-center justify-between gap-5 rounded-sm py-6 transition hover:text-teal-200"
          >
            <div>
              <h2 class="font-semibold text-white transition group-hover:text-teal-200">
                GitHub
              </h2>
              <p class="mt-1 text-sm leading-6 text-slate-400">
                Explore meus repositórios e código.
              </p>
            </div>
            <span
              aria-hidden="true"
              class="text-teal-200 transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
            >
              ↗
            </span>
          </a>
          <a
            href={site.resume}
            download
            class="group flex items-center justify-between gap-5 rounded-sm py-6 transition hover:text-teal-200"
          >
            <div>
              <h2 class="font-semibold text-white transition group-hover:text-teal-200">
                Currículo (PDF)
              </h2>
              <p class="mt-1 text-sm leading-6 text-slate-400">
                Conheça minha formação e trajetória.
              </p>
            </div>
            <span
              aria-hidden="true"
              class="text-teal-200 transition-transform group-hover:translate-y-0.5"
            >
              ↓
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
